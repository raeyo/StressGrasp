+++ b/eval_report.py
@@ -0,0 +1,107 @@
+"""Opt-in per-episode evaluation instrumentation (`debug=eval_report`).
+
+Reproduces the `is_testing` eval loop of algo/ppo_onestep/ppo.py exactly, but records
+one CSV row per (round, env) instead of only printing the per-round success rate.
+Does not alter env behavior in any way.
+"""
+
+import csv
+
+import torch
+
+
+CSV_FIELDS = [
+    "round", "env_id", "object_name", "mass_kg",
+    "init_x", "init_y", "init_z", "init_qx", "init_qy", "init_qz", "init_qw",
+    "delta_z", "success", "has_hit_table", "settled_bbox_z", "settled_footprint",
+]
+
+
+def _settled_pcl_extents(env):
+    """World-frame AABB of the settled object pcl: (z-extent, max horizontal extent).
+
+    Must be called right after settling (before any stepping/disturbance).
+    Returns two python lists of length num_envs, NaN-filled when pcl is unavailable.
+    """
+    nan = float("nan")
+    if not getattr(env, "enable_pcl", False) or not hasattr(env, "transform_obj_pcl_2_world"):
+        return [nan] * env.num_envs, [nan] * env.num_envs
+
+    pcl = env.transform_obj_pcl_2_world()  # (num_envs, P, 3)
+    ext = pcl.max(dim=1).values - pcl.min(dim=1).values  # (num_envs, 3)
+    bbox_z = ext[:, 2].cpu().tolist()
+    footprint = torch.maximum(ext[:, 0], ext[:, 1]).cpu().tolist()
+    return bbox_z, footprint
+
+
+def eval_report(cfg, env):
+    from run_rl_grasp import build_runner
+
+    runner = build_runner(cfg, env)
+    policy = runner.actor_critic
+    policy.eval()
+
+    num_rounds = cfg.get("num_rounds", 10)
+    out_path = cfg.get("report_csv", "eval_report.csv")
+
+    object_names = getattr(env, "object_names", None)
+    object_masses = getattr(env, "object_masses", None)
+    if object_masses is not None:
+        object_masses = object_masses.cpu().tolist()
+
+    all_env_ids = torch.arange(env.num_envs)
+    round_success_rates = []
+    total_success, total_episodes = 0.0, 0
+
+    with open(out_path, "w", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(CSV_FIELDS)
+
+        for round in range(num_rounds):
+            current_obs = env.reset_idx(all_env_ids)["obs"]
+            current_states = env.get_state()
+            with torch.no_grad():
+                actions = policy(current_obs, current_states, inference=True)
+            env.generate_reaching_plan_idx(all_env_ids, actions=actions)
+
+            # settled geometry: measured now, before any stepping/disturbance
+            settled_bbox_z, settled_footprint = _settled_pcl_extents(env)
+
+            for t in range(env.max_episode_length):
+                env_action = env.compute_reference_actions()
+                obs, reward, reset, extras = env.step(env_action)
+                if (t == env.max_episode_length - 2):
+                    successs = env.successes.clone().to(env.device)
+                    print(f"Round {round}, success rate: {successs.sum()/successs.shape[0]}")
+
+                    successes = successs.cpu().tolist()
+                    has_hit_table = env.has_hit_table.cpu().tolist()
+                    init_states = env.object_init_states[:, 0:7].cpu().tolist()
+                    object_z = env.object_pos[:, 2].cpu().tolist()
+
+                    for i in range(env.num_envs):
+                        init = init_states[i]
+                        writer.writerow([
+                            round, i,
+                            object_names[i] if object_names is not None else "unknown",
+                            object_masses[i] if object_masses is not None else float("nan"),
+                            init[0], init[1], init[2],
+                            init[3], init[4], init[5], init[6],
+                            object_z[i] - init[2],
+                            successes[i],
+                            int(has_hit_table[i]),
+                            settled_bbox_z[i], settled_footprint[i],
+                        ])
+                    f.flush()
+
+                    rate = float(successs.sum() / successs.shape[0])
+                    round_success_rates.append(rate)
+                    total_success += float(successs.sum())
+                    total_episodes += env.num_envs
+
+    print("\n=== eval_report summary ===")
+    for round, rate in enumerate(round_success_rates):
+        print(f"Round {round}, success rate: {rate}")
+    overall = (total_success / total_episodes) if total_episodes > 0 else float("nan")
+    print(f"Overall success rate: {overall} ({total_episodes} episodes)")
+    print(f"Wrote per-episode report to: {out_path}")
