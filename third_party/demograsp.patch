+    def _apply_pcl_perturbation(self, pcl):
+        """Visual-robustness degradation on the world-frame object pcl (num_envs, P, 3).
+        Mirrors exp105 perturbation.py: occlusion (random_dropout + depth noise, fixed
+        n_points) applied first, then per-env hold-last frame-drop (staleness)."""
+        N, P, _ = pcl.shape
+        # ---- occlusion: gaussian depth noise + random_dropout (dim preserved) ----
+        if self._perturb_noise > 0.0:
+            pcl = pcl + torch.randn_like(pcl) * self._perturb_noise
+        if self._perturb_dropout > 0.0:
+            n_drop = int(round(self._perturb_dropout * P))
+            if n_drop > 0:
+                # per-env: overwrite n_drop points with resampled kept points (missing -> resampled)
+                drop_idx = torch.randint(0, P, (N, n_drop), device=pcl.device)
+                keep_src = torch.randint(0, P, (N, n_drop), device=pcl.device)
+                batch = torch.arange(N, device=pcl.device).unsqueeze(1).expand(-1, n_drop)
+                pcl[batch, drop_idx] = pcl[batch, keep_src]
+        # ---- frame-drop: per-env hold-last staleness ----
+        if self._perturb_drop_prob > 0.0:
+            if self._perturb_last_pcl is None or self._perturb_last_pcl.shape != pcl.shape:
+                self._perturb_last_pcl = pcl.clone()
+                self._perturb_valid = torch.zeros(N, dtype=torch.bool, device=pcl.device)
+            drop = torch.bernoulli(torch.full((N,), self._perturb_drop_prob),
+                                   generator=self._perturb_rng).to(pcl.device).bool()
+            use_last = drop & self._perturb_valid   # only hold when we have a valid past frame
+            out = torch.where(use_last.view(N, 1, 1), self._perturb_last_pcl, pcl)
+            # update buffer for envs that passed fresh through
+            fresh = ~use_last
